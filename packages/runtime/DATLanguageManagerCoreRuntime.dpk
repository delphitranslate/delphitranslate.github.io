package DATLanguageManagerCoreRuntime;

{$DESCRIPTION 'DAT Language Manager shared runtime package'}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl;

contains
  DAT.Runtime.LanguagePack in '..\..\source\runtime\DAT.Runtime.LanguagePack.pas',
  DAT.Runtime.Preference in '..\..\source\runtime\DAT.Runtime.Preference.pas',
  DAT.Runtime.LayoutOverrides in
    '..\..\source\runtime\DAT.Runtime.LayoutOverrides.pas',
  DAT.Runtime.Manager in '..\..\source\runtime\DAT.Runtime.Manager.pas',
  DAT.Components.Core in '..\..\source\components\DAT.Components.Core.pas';

end.
