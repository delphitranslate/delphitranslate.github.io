{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmartindub.github.io/delphi-app-translation/schemas/layout-proposal.schema.json",
  "title": "Delphi App Translation runtime layout proposal",
  "type": "object",
  "required": ["schemaVersion", "applicationId", "languageCode", "advisoryOnly", "targetSourceModified", "proposals"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "applicationId": { "type": "string" },
    "languageCode": { "type": "string" },
    "advisoryOnly": { "type": "boolean" },
    "runtimeApplication": { "type": "string" },
    "acceptedSafeCount": { "type": "integer", "minimum": 0 },
    "targetSourceModified": { "const": false },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["formName", "componentName", "propertyName", "currentValue", "proposedValue", "rationale", "decision", "sourceChecksum"],
        "properties": {
          "formName": { "type": "string" },
          "componentName": { "type": "string" },
          "propertyName": { "type": "string" },
          "currentValue": { "type": "string" },
          "proposedValue": { "type": "string" },
          "rationale": { "type": "string" },
          "decision": { "enum": ["pending", "accepted", "rejected", "manual"] },
          "sourceChecksum": { "type": "string", "minLength": 1 }
          ,"runtimeEligible": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
