{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmartindub/DelphiAppTranslationStudio/schemas/runtime-language-pack.schema.json",
  "title": "Delphi App Translation Runtime Language Pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "applicationId",
    "framework",
    "sourceLanguage",
    "sourceCatalogChecksum",
    "language",
    "strings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "applicationId": {
      "type": "string",
      "minLength": 1
    },
    "applicationVersion": {
      "type": "string"
    },
    "framework": {
      "enum": [
        "VCL",
        "FireMonkey"
      ]
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 2
    },
    "sourceCatalogChecksum": {
      "type": "string",
      "minLength": 16
    },
    "language": {
      "type": "object",
      "required": [
        "code",
        "nativeName",
        "direction"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2
        },
        "nativeName": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      }
    },
    "locale": {
      "type": "object",
      "properties": {
        "shortDateFormat": {
          "type": "string"
        },
        "longDateFormat": {
          "type": "string"
        },
        "shortTimeFormat": {
          "type": "string"
        },
        "longTimeFormat": {
          "type": "string"
        },
        "decimalSeparator": {
          "type": "string"
        },
        "thousandSeparator": {
          "type": "string"
        },
        "currencySymbol": {
          "type": "string"
        }
      }
    },
    "strings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sourceStrings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sourceTemplates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
