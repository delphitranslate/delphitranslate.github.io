{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delphitranslate.github.io/source/schemas/project-glossary.schema.json",
  "title": "Delphi App Translation project glossary",
  "type": "object",
  "required": ["schemaVersion", "applicationId", "sourceLanguage", "targetLanguage", "terms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "applicationId": { "type": "string", "minLength": 1 },
    "sourceLanguage": { "type": "string", "minLength": 2 },
    "targetLanguage": { "type": "string", "minLength": 2 },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceText", "targetText", "approved"],
        "properties": {
          "sourceText": { "type": "string", "minLength": 1 },
          "targetText": { "type": "string", "minLength": 1 },
          "semanticConcept": { "type": "string" },
          "contextKind": { "type": "string" },
          "developerNote": { "type": "string" },
          "caseSensitive": { "type": "boolean" },
          "approved": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
