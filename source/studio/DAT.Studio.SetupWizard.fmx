              Size.PlatformDefault = False
              ReadOnly = True
              ShowScrollBars = True
              WordWrap = True
              Lines.Strings = (
                'After final processing:'
                '1. Start RAD Studio without opening the target form.'
                '2. Choose Component > Install Packages, then click Add.'
                '3. Select the exact design BPL shown by this wizard.'
                '4. Confirm the DAT package is checked, then click OK.'
                '5. Open the target project and its primary form.'
                '6. Place one DAT language manager and, optionally, one DAT language combo box.'
                '7. Set ApplicationId to the project name and leave LanguagesFolder as Localization\\Languages.'
                '8. Save the form and build the required configurations.')
            end
