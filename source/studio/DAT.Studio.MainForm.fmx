  object dlgOpenProject: TOpenDialog
    DefaultExt = 'dproj'
    Filter = 
      'Delphi projects (*.dproj;*.dpr)|*.dproj;*.dpr|Delphi project fil' +
      'es (*.dproj)|*.dproj|Delphi source projects (*.dpr)|*.dpr'
    Options = [ofHideReadOnly, ofFileMustExist, ofEnableSizing]
    Left = 1104
    Top = 52
  end
  object dlgOpenCatalog: TOpenDialog
    DefaultExt = 'json'
